  "query": "SELECT\n    si.id,\n    si.journey_id,\n    si.seat_id,\n    si.status::text AS \"status!\"\nFROM seat_inventory si\nINNER JOIN seats s ON s.id = si.seat_id\nINNER JOIN coaches c ON c.id = s.coach_id\nWHERE si.journey_id = $1\n  AND c.coach_number = $2\n  AND s.seat_number = $3\nFOR UPDATE OF si",
